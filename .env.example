# docker-compose uchun: cp .env.example .env

APP_ENV=production
HTTP_PORT=80

# PostgreSQL
POSTGRES_DB=uzbekona
POSTGRES_USER=uzbekona
POSTGRES_PASSWORD=change-me-strong-password

# JWT imzo kaliti — kamida 32 belgi. Yaratish: openssl rand -hex 32
JWT_SECRET=

# HTTPS orqali ishlasa true (Cloudflare/SSL). Lokal http://localhost uchun false
COOKIE_SECURE=true
# Admin panel ochiladigan domen(lar), vergul bilan
CORS_ORIGINS=https://uzbekona.dev

# Birinchi admin (adminlar jadvali bo'sh bo'lganda bir marta yaratiladi)
ADMIN_NAME=Xojisaid Mannopov
ADMIN_EMAIL=admin@uzbekona.dev
ADMIN_PASSWORD=

# Boshlang'ich kontent (xizmatlar, kategoriyalar, demo loyihalar) — faqat bo'sh bazaga
SEED_DEMO=true

MAX_UPLOAD_MB=100

# Ixtiyoriy: yangi so'rovlar haqida Telegram bildirishnomasi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
